# Copy to .env.local for local development. Everything is optional locally:
# without DATABASE_URL a PGlite database is created in .data/, and without
# GitHub App settings scoring is simulated (GITHUB_MODE=mock) and you can
# sign in as any user at /signin.

# --- Required in production -------------------------------------------------
APP_URL=http://localhost:3000
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Neon Postgres (pooled connection string)
DATABASE_URL=
# Where the per-task source bundles are hosted (GitHub Pages of this repo)
BUNDLE_BASE_URL=https://defdevio.github.io/areyoubetterthan.ai/bundles

# --- GitHub App (sign-in + scoring bot) --------------------------------------
GITHUB_MODE=app
GITHUB_APP_ID=
# PEM contents; literal "\n" sequences are converted to newlines
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
SUBMISSIONS_REPO=defdevio/areyoutbetterthan.ai-submissions

# --- Optional ---------------------------------------------------------------------
# Vercel sends this as a bearer token to /api/cron/reconcile
CRON_SECRET=
# Max concurrently running scoring jobs across all users (Actions concurrency ~20)
MAX_ACTIVE_JOBS=18
# Scored attempts needed before the pooled human row is ranked on /stats
# ABT_HUMAN_MIN_ATTEMPTS=10
# How long public stats are memoized per server instance (ms)
# ABT_STATS_TTL_MS=30000
# Scored tasks before someone gets a rank on /leaderboard
# ABT_RANK_MIN_TASKS=5

# --- Local development only -------------------------------------------------------
# PGLITE_DIR=.data/pglite  (dev:fixtures uses .data/pglite-fixtures)
# MOCK_SCORE_MS=6000
# ABT_FIXTURES=1   # tiny synthetic task set with offline bundles
