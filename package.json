{
  "name": "areyoubetterthan.ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/seed-dev.ts && next dev",
    "dev:fixtures": "ABT_FIXTURES=1 PGLITE_DIR=.data/pglite-fixtures tsx scripts/seed-dev.ts && ABT_FIXTURES=1 PGLITE_DIR=.data/pglite-fixtures next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "E2E_PROD=1 playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-dev.ts",
    "data:tasks": "tsx scripts/ingest-tasks.ts",
    "data:validate": "tsx scripts/validate-tasks.ts",
    "data:select": "tsx scripts/select-tasks.ts",
    "data:bundles": "tsx scripts/build-bundles.ts",
    "data:models": "tsx scripts/ingest-models.ts",
    "data:vals": "tsx scripts/ingest-vals.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@monaco-editor/react": "^4.7.0",
    "@neondatabase/serverless": "^1.2.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@vercel/analytics": "^2.0.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "flag-icons": "^7.6.0",
    "i18n-iso-countries": "^7.14.0",
    "jose": "^6.2.12",
    "monaco-editor": "^0.57.0",
    "next": "16.4.2",
    "obscenity": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-simple-maps": "^5.0.5",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "simple-icons": "^16.35.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.14.0"
}
